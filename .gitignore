# Editors & tools
.idea/
.vscode/
.claude/
.gemini/
.antigravitycli/
.agora-code/
*.swp
*.swo
*~
graphify-out/

# OS cruft
.DS_Store
Thumbs.db

# Local runtime state
.env
.env.local
config.yaml
data/
coverage.out
coverage.txt
benchmarks.txt
junit.xml
web/test-results/
*.log

# Go vendor tree — pulled via `go mod download` (go.sum pins integrity).
# Keep out of git to avoid noisy dependency-bump diffs and 40+ MB bloat.
vendor/

# Compiled binary from local `go build`
/elara

# Helm chart artifacts
*.tgz
.cr-release-packages/

# goreleaser local build output (`goreleaser release --snapshot --clean`)
/dist/

# mkdocs build output (`mkdocs build` / `mkdocs serve`) — the published site is
# built by .github/workflows/docs.yml and lives on the gh-pages branch.
/site/

# git-cliff-action's default output directory. release.yml points OUTPUT at
# the runner temp dir instead, so this should never appear — it is here as a
# safety net, because an untracked file in the tree makes goreleaser abort the
# release ("git is in a dirty state").
/git-cliff/

# Claude code
CLAUDE.md
GEMINI.md
.mcp.json
plans